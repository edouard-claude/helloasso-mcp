# Copy to .env (git-ignored) and fill in. Never commit the real values.
# API client: HelloAsso back office → My account → Integrations and API.
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
# production (default) or sandbox
HELLOASSO_ENVIRONMENT=production
# The organization slug tools default to, as in helloasso.com/associations/{slug}
HELLOASSO_ORGANIZATION=
# 1 to withhold every write tool (refunds, cancellations, checkouts…)
HELLOASSO_READ_ONLY=0
